{
  "id": "google",
  "displayName": "Google",
  "apiKeyEnvVar": "GOOGLE_API_KEY",
  "defaultModel": "gemini-3.1-flash-image",
  "docsURL": "https://ai.google.dev/gemini-api/docs/image-generation",
  "models": [
    {
      "id": "veo-3.1-generate-preview",
      "name": "Veo 3.1",
      "media": "video",
      "family": "veo",
      "aliases": [
        "veo",
        "veo-3.1"
      ],
      "params": [
        {
          "paramID": "aspectRatio",
          "flagID": "aspect-ratio",
          "allowedValues": [
            "16:9",
            "9:16"
          ]
        },
        {
          "paramID": "resolution",
          "flagID": "resolution",
          "allowedValues": [
            "720p",
            "1080p",
            "4k"
          ]
        },
        {
          "paramID": "durationSeconds",
          "flagID": "duration",
          "allowedValues": [
            "4",
            "6",
            "8"
          ],
          "ruleDescription": "forced to 8 when reference images are supplied, when extending a video, or when the resolution is 1080p or 4k"
        },
        {
          "flagID": "input-media",
          "maxMultiple": 3,
          "modelInfoComment": "Veo 3.1 special usage: <[first:|last:]media-file>. For the media to be used for the opening or closing frame, add a 'first:' or 'last:' prefix (e.g., first:image.png). See online docs for details on specifying frames for input media: https://bildomat.com/docs."
        },
        {
          "paramID": "seed",
          "flagID": "seed"
        },
        {
          "paramID": "personGeneration",
          "flagID": "person-generation",
          "modelInfoComment": "Google accepts allow_all for text-to-video and video extension, and only allow_adult for image-to-video, interpolation, and reference-image requests; in the EU, the UK, Switzerland, and the MENA regions only allow_adult is accepted."
        },
        {
          "paramID": "negativePrompt",
          "flagID": "negative-prompt"
        }
      ]
    },
